{
  "name": "openclaw-tool-output-normalizer",
  "version": "0.1.0",
  "description": "OpenClaw plugin and normalization engine for compressing noisy tool outputs into structured summaries.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./openclaw": {
      "default": "./dist/openclaw.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "openclaw.extensions": [
    "./dist/openclaw.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openclaw/openclaw-tool-output-normalizer.git"
  },
  "homepage": "https://github.com/openclaw/openclaw-tool-output-normalizer#readme",
  "bugs": {
    "url": "https://github.com/openclaw/openclaw-tool-output-normalizer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "llm",
    "token-optimization",
    "context-optimization",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw.js"
    ]
  }
}
